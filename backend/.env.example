# Путь к JSON-ключу service account Google.
# На Amvera загрузите ключ как секретный файл по этому пути.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# ID корневой папки библиотеки, внутри которой лежат папки-книги.
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# URL frontend-приложения Amvera. Несколько адресов можно указать через запятую.
CORS_ORIGINS=https://your-frontend.amvera.io

# Токен Telegram-бота: нужен backend для проверки подписанного initData.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Подключите постоянный диск Amvera к /data.
DATABASE_PATH=/data/audiobook.db
